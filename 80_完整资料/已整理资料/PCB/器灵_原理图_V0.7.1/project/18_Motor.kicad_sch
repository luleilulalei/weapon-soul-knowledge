(text "M1=LD0832BC-0195F / C7472499" (at 510 18 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "2037f45e-215e-55c8-9fe1-2a3a16fb3c37"))
(text "本版明确LRA，不使用ERM偏心马达。" (at 510 24 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "512116b3-fc53-593a-8c80-76e468a34018"))
(text "U105=DRV2605LDGSR / C527464。" (at 510 30 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "fc8ffa67-43c0-53ca-a30b-4407908478bb"))
(text "VSSOP10，无暴露焊盘；勿套HVSSOP。" (at 510 36 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "c32ea9ff-f08e-571e-a4ff-6fb314186836"))
(text "1REG 2SCL 3SDA 4IN/TRIG接地，" (at 510 42 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "c4c22119-547a-55e2-ae7c-f963e6a81d03"))
(text "5EN 6VDD 7OUT+ 8GND 9OUT- 10VDD。" (at 510 48 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "6ceeaad1-db3e-5377-ba12-387c057efaf6"))
(text "VDD取同+3V3网，实际目标3.192V。" (at 510 54 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "814fde49-6e91-5eb8-997b-e638a2b40786"))
(text "不要接5V：驱动工作最高5.2V。" (at 510 60 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "816eaeae-a076-5cd1-9267-5e451e42a461"))
(text "C119=10µF；C121=1µF输入去耦。" (at 510 66 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "8d941efc-c583-50a2-af11-317891bf7c9d"))
(text "C120=1µF REG去耦，REG禁止带外部负载。" (at 510 72 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "f0921e6c-8cc5-5f85-89d1-a8c206431f73"))
(text "GPIO6→R135(1k)→EN，R136(100k)下拉。" (at 510 78 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "fb71199b-ffac-5aa8-b2c4-f772ff74df6b"))
(text "GPIO18恢复NC，不再低侧PWM。" (at 510 84 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "abaa383f-00c3-53d7-b777-ee5d260c454c"))
(text "I2C地址0x5A，保留现4.7k上拉。" (at 510 90 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "e0917c96-d054-57bf-984b-628eb993eaf8"))
(text "先100kHz，实测上升时间后再提速。" (at 510 96 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "0606da02-5391-52f9-931d-ae2ad8eecb22"))
(text "J110只接口，M1唯一LRA。" (at 510 102 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "ad8ba216-2d4c-5cd4-96a2-0b272dbf999d"))
(text "两端均差分输出，不得任一接地。" (at 510 108 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "a7b796b3-0df2-5545-8fe4-60c7e549f700"))
(text "删除旧TPS709、Q101及续流二极管，" (at 510 114 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "65a73774-41cf-5ed1-861b-4bc66ffbfdc6"))
(text "删除旧跨马达电容及J109隔离跳线。" (at 510 120 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "e5fa00d7-e4b7-536f-bb1a-b9125ab17d36"))
(text "EN低停驱动但不清寄存器。" (at 510 126 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "90e36bd2-35c4-53b3-bc3c-d0b5da9889cf"))
(text "上电等待≥250µs，显式复位及LRA配置。" (at 510 132 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "e4c5c73e-e69b-55a9-9ed7-4dd003b5e409"))
(text "按精确型号校准及核电压，失败禁振。" (at 510 138 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "3638b852-fd45-5440-b28e-50da580c1889"))
(text "只用有限时长单次效果，不用无限RTP。" (at 510 144 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "083c071b-9e95-5c27-aacd-53d3d887d2b6"))
