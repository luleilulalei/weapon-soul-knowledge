(text "待机I2C锁死可能需整机断电恢复。" (at 510 156 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "ffa03ae4-7fca-5801-9686-4809c72b9eb7"))
(text "主控复位EN下拉；卡死仍需有限波形。" (at 510 162 0) (effects (font (face "Noto Sans CJK SC") (size 1.8 1.8)) (justify left top)) (uuid "a1bb11c4-27d7-5c44-b377-f1d8ca7fd1d2"))
