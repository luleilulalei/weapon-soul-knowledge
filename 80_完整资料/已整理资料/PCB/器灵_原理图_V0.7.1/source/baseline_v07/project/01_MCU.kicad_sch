(text "V0.3 读图说明 | MCU 主控与下载" (at 426 18 0) (effects (font (face "Noto Sans CJK SC") (size 2.0 2.0)) (justify left top)) (uuid "1502ffce-6483-5330-84ac-015f335a3f36"))
(text "用途：ESP32-S3 主控、复位、下载与调试。" (at 426 26 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "4d37893c-d32f-59f4-bbbc-ca9134e30c8a"))
(text "数字为模组焊盘号；GPIO 名称不是焊盘编号。" (at 426 30.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "4b32fb51-0dae-50ce-baaa-734caea4793d"))
(text "例：U1.12 = GPIO8 = BOOST_EN；" (at 426 35.0 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "9d010d09-1113-5a18-9036-5bca25409dfe"))
(text "U1.34/35 = GPIO41/42 = I2C_SCL/SDA。" (at 426 39.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "6d53e869-0364-51aa-a4a6-05424c03070e"))
(text "U1.13/14 = GPIO19/20 = USB_DM/DP。" (at 426 44.0 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "6f7e82ce-4557-58da-b87f-553971bf3e98"))
(text "U1.28/29/30 = GPIO35/36/37：保留 NC，" (at 426 48.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "0c5c9a55-917a-57c2-b7ad-18a51551cf83"))
(text "N16R8 的 Octal PSRAM 占用这些 GPIO。" (at 426 53.0 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "fe6341de-3c63-5fa3-9529-b5589cc10c53"))
(text "GPIO3/45/46 未用；GPIO0 仅用于 BOOT。" (at 426 57.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "88e9d838-67e6-50c6-ba95-6e1db2e7620d"))
(text "U1.6 / GPIO6 用于LRA驱动EN；保留单麦。" (at 426 62.0 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "f22ae340-84e6-5781-aed2-bb4d8d265fbf"))
(text "J1 的 3V3 是目标电压参考，勿与调试器双供电。" (at 426 66.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "091b998b-ec1b-512f-bba3-59379734ece1"))
(text "" (at 426 71.0 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "ec7b6bd6-d744-5ddc-b1a8-173f00c77432"))
(text "阅读约定 / 审查边界" (at 426 75.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "f892e380-8fcb-5158-a809-4719271169d0"))
(text "同名全局标签在 KiCad 中表示电气连接。" (at 426 80.0 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "846adaba-b3df-598d-add7-5e57b0248d0e"))
(text "符号矩形是逻辑表示，不表示器件外形。" (at 426 84.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "702a10d4-9173-503b-b1f0-49eb38e35d85"))
(text "接口脚序以本图标注为准；实物方向必须复核。" (at 426 89.0 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "1c7088b5-0ec1-5830-afdd-693d680e47f3"))
(text "LCSC / Footprint 为候选，非已核验采购绑定。" (at 426 93.5 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "0526d81d-03e2-5311-b817-e3f62b1e5aa7"))
(text "DNP = 不装：C110、C114；R39为已装68Ω背光限流。" (at 426 98.0 0) (effects (font (face "Noto Sans CJK SC") (size 1.5 1.5)) (justify left top)) (uuid "56999ab8-dddf-5223-9f93-f06b368c90b6"))
