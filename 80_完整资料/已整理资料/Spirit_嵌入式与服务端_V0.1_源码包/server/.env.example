# Spirit local development; intentionally no credentials.
USAKI_SERVER_NAME=spirit-server
USAKI_DEVICE_PROFILE=spirit
USAKI_MEMORY_ENABLED=false
USAKI_MEMORY_SHARE_WITH_LLM=false
USAKI_STT_PROVIDER=stub
USAKI_LLM_PROVIDER=stub
USAKI_TTS_PROVIDER=stub
USAKI_AUDIO_VAD_PROVIDER=rms
# Optional provider setup: fill locally, never commit .env.
# USAKI_LLM_BASE_URL=https://your-provider.example/v1
# USAKI_LLM_MODEL=your-model
# USAKI_LLM_API_KEY=replace-locally
# USAKI_XFYUN_REALTIME_ASR_APP_ID=replace-locally
# USAKI_XFYUN_REALTIME_ASR_API_KEY=replace-locally
# USAKI_XFYUN_REALTIME_ASR_API_SECRET=replace-locally
# USAKI_XFYUN_TTS_APP_ID=replace-locally
# USAKI_XFYUN_TTS_API_KEY=replace-locally
# USAKI_XFYUN_TTS_API_SECRET=replace-locally
