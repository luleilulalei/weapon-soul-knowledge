{"type":"TEXT","ticket":163,"id":"ie161"}||{"partId":"","groupId":"","locked":false,"zIndex":161,"x":1677.16535,"y":421.25984,"rotation":0,"value":"接口脚序以本图标注为准；实物方向必须复核。","color":null,"fillColor":null,"fontFamily":null,"fontSize":5.90551,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
{"type":"TEXT","ticket":164,"id":"ie162"}||{"partId":"","groupId":"","locked":false,"zIndex":162,"x":1677.16535,"y":438.97638,"rotation":0,"value":"LCSC / Footprint 为候选，非已核验采购绑定。","color":null,"fillColor":null,"fontFamily":null,"fontSize":5.90551,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
{"type":"TEXT","ticket":165,"id":"ie163"}||{"partId":"","groupId":"","locked":false,"zIndex":163,"x":1677.16535,"y":456.69291,"rotation":0,"value":"DNP = 不装：C110、C114；R39为已装68Ω背光限流。","color":null,"fillColor":null,"fontFamily":null,"fontSize":5.90551,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
{"type":"TEXT","ticket":166,"id":"ie164"}||{"partId":"","groupId":"","locked":false,"zIndex":164,"x":1677.16535,"y":474.40945,"rotation":0,"value":"本版仅供工程审查，不能直接投板/下单。","color":null,"fillColor":null,"fontFamily":null,"fontSize":5.90551,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
{"type":"TEXT","ticket":167,"id":"ie165"}||{"partId":"","groupId":"","locked":false,"zIndex":165,"x":90,"y":1094.48819,"rotation":0,"value":"V0.7.1继承CAP1296与单麦；分图按改动保留各自修订号。","color":null,"fillColor":null,"fontFamily":null,"fontSize":6.29921,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
{"type":"TEXT","ticket":168,"id":"ie166"}||{"partId":"","groupId":"","locked":false,"zIndex":166,"x":90,"y":1122.04724,"rotation":0,"value":"V0.7.1: LRA专用驱动及单扬声器/单LRA外接物料；屏幕改10针FPC裸屏，电池充电仍禁用。","color":null,"fillColor":null,"fontFamily":null,"fontSize":5.51181,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
{"type":"TEXT","ticket":169,"id":"ie167"}||{"partId":"","groupId":"","locked":false,"zIndex":167,"x":90,"y":1149.6063,"rotation":0,"value":"V0.7.1: 显示接口改10针FPC，Waveshare8线方案作废；+3V3网实际目标3.192V；先核FPC方向后通电。","color":null,"fillColor":null,"fontFamily":null,"fontSize":5.51181,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
{"type":"TEXT","ticket":170,"id":"ie168"}||{"partId":"","groupId":"","locked":false,"zIndex":168,"x":90,"y":1177.16535,"rotation":0,"value":"V0.7.1: LRA+DRV2605L替代ERM/TPS709；GPIO6为EN、GPIO18为NC；同3.192V逻辑轨供电；充电仍禁用。","color":null,"fillColor":null,"fontFamily":null,"fontSize":5.51181,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
{"type":"TEXT","ticket":171,"id":"ie169"}||{"partId":"","groupId":"","locked":false,"zIndex":169,"x":90,"y":1204.72441,"rotation":0,"value":"V0.7.1：仅移除JP1并直供Q1源极；保留Q1与U9/U10，屏/LRA/I2C附件/充电电气不变。","color":null,"fillColor":null,"fontFamily":null,"fontSize":5.51181,"strikeout":false,"underline":false,"italic":false,"fontWeight":false,"align":"LEFT_TOP"}|
